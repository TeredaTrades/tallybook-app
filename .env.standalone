# Used by `npm run build:standalone` (vite --mode standalone).
# VITE_APP_VARIANT is read in src/App.jsx to drop the Home hub (and, with it,
# Loan Calculator / Budget / Trip Organizer / forex / news, which are only
# reachable from Home) and land straight in Cashbooks.
VITE_APP_VARIANT=standalone-expenses
# Build output goes to its own folder so it doesn't clobber the main "dist"
# build when both are built back-to-back in CI.
OUT_DIR=dist-standalone
